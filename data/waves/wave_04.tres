interval_ticks = 55

[sub_resource type="Resource" id="Group_walkers"]
script = ExtResource("2_group")
enemy_id = "walker"
count = 8
start_delay_ticks = 120
interval_ticks = 45

[sub_resource type="Resource" id="Group_brute"]
script = ExtResource("2_group")
enemy_id = "brute"
count = 1
start_delay_ticks = 420
interval_ticks = 60

[resource]
script = ExtResource("1_wave")
id = "wave_04"
display_name = "Armour Test"
groups = [SubResource("Group_shielded"), SubResource("Group_walkers"), SubResource("Group_brute")]
