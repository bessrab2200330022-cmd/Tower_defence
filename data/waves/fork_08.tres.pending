[gd_resource type="Resource" load_steps=7 format=3]

[ext_resource type="Script" path="res://data/schemas/wave_def.gd" id="1_wave"]
[ext_resource type="Script" path="res://data/schemas/spawn_group.gd" id="2_group"]

[sub_resource type="Resource" id="Group_wardens"]
script = ExtResource("2_group")
enemy_id = "warden"
count = 1
