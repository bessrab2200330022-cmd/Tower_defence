[gd_resource type="Resource" load_steps=6 format=3]

[ext_resource type="Script" path="res://data/schemas/wave_def.gd" id="1_wave"]
[ext_resource type="Script" path="res://data/schemas/spawn_group.gd" id="2_group"]

[sub_resource type="Resource" id="Group_drones"]
script = ExtResource("2_group")
enemy_id = "drone"
count = 20
start_delay_ticks = 0
interval_ticks = 19

[sub_resource type="Resource" id="Group_shielded"]
script = ExtResource("2_group")
enemy_id = "shielded_scout"
count = 10
start_delay_ticks = 150
interval_ticks = 48

[sub_resource type="Resource" id="Group_brutes"]
script = ExtResource("2_group")
enemy_id = "brute"
count = 5
start_delay_ticks = 260
interval_ticks = 120

[resource]
script = ExtResource("1_wave")
id = "wave_05"
display_name = "Breakthrough"
groups = [SubResource("Group_drones"), SubResource("Group_shielded"), SubResource("Group_brutes")]
