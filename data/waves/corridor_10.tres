interval_ticks = 12

[resource]
script = ExtResource("1_wave")
id = "corridor_10"
display_name = "Watershed"
groups = [SubResource("Group_drones"), SubResource("Group_brutes"), SubResource("Group_shielded"), SubResource("Group_coursers")]
