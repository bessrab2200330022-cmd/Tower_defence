count = 4
start_delay_ticks = 670
interval_ticks = 55

[resource]
script = ExtResource("1_wave")
id = "wave_08"
display_name = "Phalanx"
groups = [SubResource("Group_walkers"), SubResource("Group_wardens"), SubResource("Group_shielded"), SubResource("Group_wardens_2"), SubResource("Group_shielded_2")]
