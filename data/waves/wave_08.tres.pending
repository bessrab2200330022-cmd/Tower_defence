interval_ticks = 45

[sub_resource type="Resource" id="Group_wardens"]
script = ExtResource("2_group")
enemy_id = "warden"
count = 1
start_delay_ticks = 300
interval_ticks = 60

[sub_resource type="Resource" id="Group_shielded"]
script = ExtResource("2_group")
