count = 4
start_delay_ticks = 330
interval_ticks = 55

[sub_resource type="Resource" id="Group_wardens_2"]
script = ExtResource("2_group")
enemy_id = "warden"
count = 1
start_delay_ticks = 640
interval_ticks = 60

[sub_resource type="Resource" id="Group_shielded_2"]
script = ExtResource("2_group")
