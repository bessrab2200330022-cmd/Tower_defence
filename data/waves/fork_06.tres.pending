count = 12
start_delay_ticks = 0
interval_ticks = 18
route_hint = 0

[sub_resource type="Resource" id="Group_walkers"]
script = ExtResource("2_group")
enemy_id = "walker"
count = 5
start_delay_ticks = 400
interval_ticks = 50
route_hint = 1

[resource]
script = ExtResource("1_wave")
id = "fork_06"
display_name = "Skein"
groups = [SubResource("Group_skiffs"), SubResource("Group_drones"), SubResource("Group_walkers")]
