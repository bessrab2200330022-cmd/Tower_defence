# GDScript's parser rejects mixed indentation. Tabs, always.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.gd]
indent_style = tab
indent_size = 4

[*.{tscn,tres,godot,cfg}]
indent_style = tab

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

# ASCII map boards - every character is meaningful.
[*.layout.txt]
trim_trailing_whitespace = false
